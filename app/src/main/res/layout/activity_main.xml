<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pantalla"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar vehículo"
            android:fontFamily="serif"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#5B2A4A" />

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="#B03A5E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Ingresa los datos del vehículo."
            android:fontFamily="serif"
            android:textStyle="italic"
            android:textColor="#8A6577"
            android:textSize="16sp" />

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card">

            <EditText
                android:id="@+id/etMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="Marca, por ejemplo Toyota"
                android:inputType="textCapWords"
                android:maxLength="60"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="#5B2A4A"
                android:textColorHint="#8A6577" />

            <EditText
                android:id="@+id/etModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:hint="Modelo, por ejemplo Corolla"
                android:inputType="textCapWords"
                android:maxLength="60"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="#5B2A4A"
                android:textColorHint="#8A6577" />

            <EditText
                android:id="@+id/etAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:hint="Año, por ejemplo 2024"
                android:inputType="number"
                android:maxLength="4"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="#5B2A4A"
                android:textColorHint="#8A6577" />

            <EditText
                android:id="@+id/etPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:hint="Precio COP, por ejemplo 85000000"
                android:inputType="numberDecimal"
                android:maxLength="18"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="#5B2A4A"
                android:textColorHint="#8A6577" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sin separadores de miles. Máximo 2 decimales."
                android:textColor="#8A6577"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="56dp"
                android:text="Guardar vehículo"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B03A5E"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Consultando vehículos guardados…"
            android:textSize="15sp"
            android:textColor="#5B2A4A"
            android:accessibilityLiveRegion="polite" />

        <!-- Lista de vehículos guardados -->
        <TextView
            android:id="@+id/tvTituloLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Vehículos guardados"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#5B2A4A" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Aún no hay vehículos guardados."
            android:fontFamily="serif"
            android:textStyle="italic"
            android:textColor="#8A6577"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>